#!/bin/sh
# ce: launch CyberEther with the B210 (spectrum on the CPU)
#   ce              -> use the settings below
#   ce gpu          -> same, spectrum computed on the NVIDIA GPU (CUDA)
#   ce scan         -> sweep START to END (SDR Sweep block, SoapySDR backend, patch 3)
#   ce file.yml     -> open that flowgraph as is
# Override a setting for one run: B=32 M=32 ce
# Log: ~/.cache/cyberether/last.log (ce scan: scan-<serial>.log)

# ---- Settings (edit here) ----
DEVICE="${DEVICE:-driver=uhd,type=b200,fpga=$HOME/uhd_images/usrp_b210_fpga_github.bin,num_recv_frames=1024}"
# UHD connector name, channel A. On the clone's case, UHD "RX2" (channel A) = port "RX1".
ANTENNA="${ANTENNA:-RX2}"
FREQ="${FREQ:-94900000}"       # Hz
RATE="${RATE:-61440000}"       # samples/s
GAIN="${GAIN:-auto}"           # auto, or a gain in dB (e.g. 40)
B="${B:-16}"                   # Batches (multiple of 16: AVX-512 vectorized FFT)
S="${S:-8192}"                 # Samples (FFT size)
M="${M:-4}"                    # Buffer Multiplier
# Sweep (ce scan)
SERIAL="${SERIAL:-}"           # B210 serial; empty = first free B210
START="${START:-70000000}"     # Hz
END="${END:-1000000000}"       # Hz
RES="${RES:-50000}"            # resolution in Hz (bin width)
DWELL="${DWELL:-1}"            # captures averaged per hop
SCANGAIN="${SCANGAIN:-40}"     # fixed gain in dB (auto makes hops incomparable)
# ------------------------------------

export UHD_IMAGES_DIR="$HOME/uhd_images"
DIR="$HOME/.cache/cyberether"
mkdir -p "$DIR"

case "$1" in
    *.yml|*.yaml) exec stdbuf -oL -eL /usr/local/bin/cyberether -v "$@" > "$DIR/last.log" 2>&1 ;;
esac

if [ "$1" = scan ]; then
    shift
    # The SDR Sweep block names a radio as driver=...,serial=...: the serial is required,
    # even with a single radio plugged in, so the block never opens the wrong one.
    # Without SERIAL, take the first free B210. UHD does not list a radio that is already
    # open: with two B210s (for example 2.4 GHz and 5.8 GHz at the same time), the first
    # run takes one radio and the second, started once the first window is open, the other:
    #   START=2400000000 END=2500000000 ce scan     (terminal 1)
    #   START=5725000000 END=5875000000 ce scan     (terminal 2)
    # Started at the same time, both would see the same free radio. To choose which radio
    # (so which antenna) listens to which band, set SERIAL: SERIAL=31B92DD ce scan
    if [ -z "$SERIAL" ]; then
        FREE=$(SoapySDRUtil --find="driver=uhd,type=b200" 2>/dev/null | sed -n 's/^ *serial = //p' | sort -u)
        SERIAL=$(printf '%s\n' "$FREE" | head -n 1)
        if [ -z "$SERIAL" ]; then
            echo "No free B210 found (already open in another CyberEther, or unplugged)." >&2
            exit 1
        fi
        echo "Free B210s: $(echo $FREE) -> $SERIAL"
    fi
    FG="$DIR/b210-scan-$SERIAL.yml"
    LOG="$DIR/scan-$SERIAL.log"
    cat > "$FG" <<YML
version: 2
title: B210 Sweep
summary: B210 sweep (generated by ce scan).
author: ""
license: MIT
description: SDR Sweep block (SoapySDR backend) and spectrum analyzer on the CPU.
graph:
  - name: sdr_sweep
    module: sdr_sweep
    device: cpu
    runtime: native
    provider: generic
    config:
      deviceString: 'driver=soapy,serial=$SERIAL'
      antenna: '$ANTENNA'
      automaticGain: false
      manualGain: $SCANGAIN
      biasTee: false
      startFrequency: $START
      endFrequency: $END
      sampleRate: 0
      resolution: $RES
      dwell: $DWELL
      settlingTime: 0
    meta:
      node: {x: 49, y: 94, width: 332, height: 0}
  - name: spectrum_analyzer
    module: spectrum_analyzer
    device: cpu
    runtime: native
    provider: generic
    config:
      lineplotAveraging: 4
      waterfallAveraging: 1
      maxHold: false
      fill: true
      rangeMin: -110
      rangeMax: -20
      waterfallHeight: 512
      splitRatio: 0.4
      xLabel: Frequency (MHz)
      amplitudeLabel: Amplitude (dBFS)
      waterfallLabel: Sweeps
    input:
      buffer: '\${graph.sdr_sweep.output.signal}'
    meta:
      node: {x: 497, y: 95, width: 860, height: 0}
YML
    echo "B210 $SERIAL sweep: $START to $END Hz, resolution $RES Hz, dwell $DWELL  (log: $LOG)"
    exec stdbuf -oL -eL /usr/local/bin/cyberether -v "$@" "$FG" > "$LOG" 2>&1
fi

GPU=0
if [ "$1" = gpu ]; then GPU=1; shift; fi

if [ "$GAIN" = auto ]; then
    GAINCFG="automaticGain: true"
else
    GAINCFG="automaticGain: false
      manualGain: $GAIN"
fi

if [ $GPU = 1 ]; then
    SPECDEV=cuda
    SPECIN='${graph.to_gpu.output.buffer}'
    DUPLICATE="  - name: to_gpu
    module: duplicate
    device: cpu
    runtime: native
    provider: generic
    config:
      outputDevice: cuda
      hostAccessible: true
    input:
      buffer: '\${graph.soapy.output.signal}'
    meta:
      node: {x: 400, y: 300, width: 200, height: 0}"
else
    SPECDEV=cpu
    SPECIN='${graph.soapy.output.signal}'
    DUPLICATE=""
fi

FG="$DIR/b210.yml"
cat > "$FG" <<YML
version: 2
title: B210 Spectrum
summary: B210 spectrum (generated by ce).
author: ""
license: MIT
description: SoapySDR source (UHD, B210) and spectrum analyzer.
graph:
  - name: soapy
    module: soapy
    device: cpu
    runtime: native
    provider: generic
    config:
      deviceString: '$DEVICE'
      antenna: '$ANTENNA'
      frequency: $FREQ
      frequencyStep: 1000000
      sampleRate: $RATE
      $GAINCFG
      biasTee: false
      numberOfBatches: $B
      numberOfTimeSamples: $S
      bufferMultiplier: $M
    meta:
      node: {x: 49, y: 94, width: 332, height: 0}
$DUPLICATE
  - name: spectrum_analyzer
    module: spectrum_analyzer
    device: $SPECDEV
    runtime: native
    provider: generic
    config:
      lineplotAveraging: 28
      waterfallAveraging: 4
      maxHold: false
      fill: true
      rangeMin: -100
      rangeMax: 0
      waterfallHeight: 1024
      splitRatio: 0.3037825
      xLabel: Frequency (MHz)
      amplitudeLabel: Amplitude (dBFS)
      waterfallLabel: Time
    input:
      buffer: '$SPECIN'
    meta:
      node: {x: 497, y: 95, width: 860, height: 0}
YML

echo "B210 ($SPECDEV) : $RATE S/s, Batches $B, Samples $S, Buffer Multiplier $M  (log: $DIR/last.log)"
exec stdbuf -oL -eL /usr/local/bin/cyberether -v "$@" "$FG" > "$DIR/last.log" 2>&1
